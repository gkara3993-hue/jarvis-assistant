<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0A0E14">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Otonom Otomasyon Kuralları"
        android:textColor="#00E5FF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Her kural kapalı başlar. Açtığında Jarvis o eylemi kendiliğinden yapar ama her seferinde sana bildirim gösterir."
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchHeadphoneMusic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kulaklık takınca müziği otomatik aç"
        android:textColor="#FFFFFF" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchLowBatteryWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Gece pil düşükse beni uyar"
        android:textColor="#FFFFFF" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchFocusCalendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Takvimdeki toplantılarda otomatik Rahatsız Etmeyin aç"
        android:textColor="#FFFFFF" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchAutoStartBoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Telefon açılınca Jarvis'i otomatik başlat"
        android:textColor="#FFFFFF" />

</LinearLayout>
